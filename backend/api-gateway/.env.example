# ============================================================
# api-gateway — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực vào
# KHÔNG commit file .env lên git
# ============================================================

# --- Server and multipart settings ---
SERVER_PORT=8686
SERVER_TOMCAT_CONNECTION_TIMEOUT=120000
SPRING_APPLICATION_NAME=api-gateway
SPRING_SERVLET_MULTIPART_ENABLED=true
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# --- Backend service URLs (Compose overrides these to container DNS names) ---
SERVICE_URI_USERS=http://localhost:8082
SERVICE_URI_CATALOG=http://localhost:8081
SERVICE_URI_ARTISTS=http://localhost:8083
SERVICE_URI_ADMIN=http://localhost:8084
