# ============================================================
# users-service — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực vào
# KHÔNG commit file .env lên git
# ============================================================

# --- Database ---
SERVER_PORT=8082
SPRING_APPLICATION_NAME=users-service
KAFKA_SERVERS=localhost:9092
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5MB
DB_URL=jdbc:postgresql://localhost:5432/mc_music_db?currentSchema=mc_music_users_schema
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JPA_DATABASE=POSTGRESQL
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update
JPA_FORMAT_SQL=true
JPA_SHOW_SQL=true

# --- JWT (Users domain) ---
# Phải là chuỗi ngẫu nhiên, tối thiểu 32 ký tự
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# --- Internal Service URLs ---
CATALOG_SERVICE_URL=http://localhost:8081
ARTIST_SERVICE_URL=http://localhost:8083

# --- Internal API Secret ---
# Phải khớp với giá trị INTERNAL_API_SECRET trong tất cả các service khác
INTERNAL_API_SECRET=your_shared_internal_api_secret

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
